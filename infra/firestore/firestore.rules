rules_version = "2";

// Browser access is read-only and narrowly scoped. All privileged writes go
// through the API and job service identities, which bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isProjectReader(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)/grants/$(request.auth.uid));
    }

    match /projects/{projectId} {
      allow get, list: if isProjectReader(projectId);
      allow write: if false;

      match /grants/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /runs/{runId} {
        allow get, list: if isProjectReader(projectId);
        allow write: if false;

        // Safe milestone projection only.
        match /events/{eventId} {
          allow get, list: if isProjectReader(projectId);
          allow write: if false;
        }

        match /findings/{findingId} {
          allow get, list: if isProjectReader(projectId);
          allow write: if false;
        }
      }
    }

    // Deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
